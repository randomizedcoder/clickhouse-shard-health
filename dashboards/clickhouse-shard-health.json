            "indexByName": {
              "Cluster": 0,
              "Host": 1,
              "Replica": 3,
              "Shard": 2,
              "Status": 4
            },
            "renameByName": {
              "Value": "Status",
              "cluster": "Cluster",
              "host": "Host",
              "replica_num": "Replica",
              "shard_num": "Shard"
